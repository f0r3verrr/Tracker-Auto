# Скопируй в .env.local и подставь значения из Supabase → Project Settings → API
VITE_SUPABASE_URL=https://<project-id>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon public key>

# Общий код доступа к сайту (не персональный логин, спрашивается один раз).
# Оставь пустым, чтобы отключить экран с кодом.
VITE_SITE_ACCESS_CODE=

# ВНИМАНИЕ: service_role и sb_secret_* ключи сюда не кладём никогда.
# Они обходят RLS и не должны попадать во фронтенд.
